# Account or workspace token: https://railway.com/account/tokens
RAILWAY_API_TOKEN=

# The project this console is allowed to touch. From the project URL:
# railway.com/project/<RAILWAY_PROJECT_ID>
RAILWAY_PROJECT_ID=

# Environment inside that project (usually "production").
# Find it in the URL when an environment is selected, or via the API.
RAILWAY_ENVIRONMENT_ID=

# Shared secret the UI must present. Generate one:  openssl rand -hex 24
ACCESS_KEY=

# Optional guardrails
MAX_CONTAINERS=5
ALLOWED_IMAGES=redis:7-alpine,nginx:alpine,postgres:16-alpine,memcached:alpine
